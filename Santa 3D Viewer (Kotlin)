## `src/main/java/com/example/santaview/MainActivity.kt`

```kotlin
package com.example.santaview

import android.os.Bundle
import android.util.Log
import android.view.View
import androidx.appcompat.app.AppCompatActivity
import io.github.sceneview.SceneView
import io.github.sceneview.loaders.loadModelAsync
import io.github.sceneview.node.ModelNode
import kotlinx.coroutines.*

class MainActivity : AppCompatActivity() {

    private lateinit var sceneView: SceneView
    private val job = SupervisorJob()
    private val scope = CoroutineScope(Dispatchers.Main + job)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        sceneView = findViewById(R.id.sceneView)

        // Carrega o modelo GLB da pasta assets/models/santa.glb
        // Caminho relativo aceito: "models/santa.glb"
        val modelPath = "models/santa.glb"

        // show a simple progress overlay if quiser (não incluído aqui)

        // Carregamento assíncrono do modelo (coroutine)
        sceneView.loadModelAsync(modelPath) { model ->
            if (model == null) {
                Log.e("MainActivity", "Erro ao carregar modelo: modelo nulo")
                return@loadModelAsync
            }

            // Cria um ModelNode a partir do Model carregado e adiciona à cena
            val modelNode = ModelNode(model)

            // Ajustes finos: posição, escala e rotação para ficar centralizado e com tamanho adequado
            modelNode.position = floatArrayOf(0f, 0f, 0f)
            modelNode.scale = floatArrayOf(1f, 1f, 1f) // ajuste conforme seu modelo

            // Adiciona ao root da cena
            sceneView.addChild(modelNode)

            // Opcional: centraliza a câmera para focar no novo nó
            sceneView.cameraController?.let { controller ->
                controller.setTarget(modelNode.position)
            }
        }

        // Botão fechar (opcional)
        findViewById<View>(R.id.closeButton).setOnClickListener { finish() }
    }

    override fun onResume() {
        super.onResume()
        sceneView.onResume()
    }

    override fun onPause() {
        super.onPause()
        sceneView.onPause()
    }

    override fun onDestroy() {
        super.onDestroy()
        job.cancel()
        sceneView.destroy()
    }
}
```

